#!/bin/bash

# === A setup script to be called in .bashrc or equivalent ===

export XDG_CONFIG_HOME="$HOME/.config"

# Add ~/.local/bin to PATH (required for some user-level installations such as pylsp)
usr_bin="$HOME/.local/bin"
if [ -d "${usr_bin}" ] && [[ ":$PATH:" != *":${usr_bin}:"* ]]; then
    PATH="${PATH:+"$PATH:"}${usr_bin}"
fi

# fzf setup
eval "$(fzf --bash)" # Usually in .bashrc, moved here to keep fzf setup together
export FZF_DEFAULT_COMMAND="fd -H -t f -E .git -E '{,.}venv'"
_fzf_setup_completion path vim

_fzf_compgen_path() {
  fd -H -E .git -E '{,.}venv' "$1"
}

_fzf_compgen_dir() {
  fd -H -t d -E .git -E '{,.}venv' "$1"
}

# Additional environment variables
# export BASH_IDE_LOG_LEVEL=error # for bash-language-server
export BACKGROUND_ANALYSIS_MAX_FILES=0 # for bash-language-server

# Git autocompletion
source /usr/share/git/completion/git-completion.bash

# Override prompt
format_git_prompt() {
    if git_curr_branch=$(git branch --show-current 2>/dev/null) && [[ -n "$git_curr_branch" ]]; then
        git_ahead_count='-'
        git_behind_count='-'

        default_colour="\e[01;37m"
        modified_colour="$default_colour"
        ahead_colour="$default_colour"
        behind_colour="$default_colour"

        git fetch > /dev/null 2>&1 &
        git_modified_tracked_count=$(git status -s -uno | wc -l)
        git_untracked_count=$(git ls-files --others --exclude-standard | wc -l)
        git_modified_count="$((${git_modified_tracked_count}+${git_untracked_count}))"
        if [[ "$git_modified_count" -ne 0 ]]; then modified_colour="\e[01;34m"; fi

        # Error handling to handle no upstream
        if count="$(git rev-list "$git_curr_branch" --not "origin/$git_curr_branch" --count 2>/dev/null)"; then
            git_ahead_count="$count"
            if [[ "$count" -ne 0 ]]; then ahead_colour="\e[01;32m"; fi
        fi
        if count="$(git rev-list "origin/$git_curr_branch" --not "$git_curr_branch" --count 2>/dev/null)"; then
            git_behind_count="$count"
            if [[ "$count" -ne 0 ]]; then behind_colour="\e[01;31m"; fi
        fi

        echo -e "\e[33m $git_curr_branch $modified_colour󰓦 $git_modified_count $ahead_colour $git_ahead_count $behind_colour $git_behind_count "
    fi
}

prompt_marker() {  # OSC 133;A to make the start of the prompt (for terminal integration)
    printf '\e]133;A\e\\'
}

PROMPT_COMMAND='GIT_PROMPT=$(format_git_prompt); prompt_marker'
PS1='\[\e[37m\]\A \[\e[35m\]\w\[\e[0m\] ${GIT_PROMPT}\n\[\e[35m\]󰘍 \$ \[\e[0m\]'

# zoxide setup
eval "$(zoxide init bash)"
